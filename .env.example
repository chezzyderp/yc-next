# Yandex Cloud target. Required.
YC_FOLDER_ID=
YC_SERVICE_ACCOUNT_ID=

# Optional: only set if your account spans multiple clouds.
# YC_CLOUD_ID=

# Optional default function-name prefix when bundles do not pin a name.
# YC_FUNCTION_PREFIX=next

# Object Storage credentials. Required only when bundles exceed ~3.5 MB
# (the inline upload limit for `yc serverless function version create`)
# or when --useObjectStorage is forced on the deploy script.
# YC_STORAGE_ACCESS_KEY=
# YC_STORAGE_SECRET_KEY=

# Optional Object Storage bucket. Default: <functionName>-deploys.
# YC_STORAGE_BUCKET=

# Optional Object Storage endpoint/region overrides.
# YC_STORAGE_REGION=ru-central1
# YC_STORAGE_ENDPOINT=https://storage.yandexcloud.net
